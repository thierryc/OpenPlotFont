{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPlotFont draft 0.4",
  "description": "Structural constraints; use the semantic validator for Unicode, references, uniqueness, finite numbers, and resource limits.",
  "type": "object",
  "properties": {
    "format": {
      "const": "OpenPlotFont"
    },
    "version": {
      "const": "0.4"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "familyName": {
      "type": "string",
      "minLength": 1
    },
    "styleName": {
      "type": "string",
      "minLength": 1
    },
    "unitsPerEm": {
      "type": "integer",
      "minimum": 1
    },
    "metrics": {
      "type": "object",
      "properties": {
        "ascender": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "descender": {
          "type": "number",
          "maximum": 0
        },
        "capHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "xHeight": {
          "type": "number",
          "minimum": 0
        },
        "lineGap": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "ascender",
        "descender",
        "capHeight",
        "xHeight",
        "lineGap"
      ]
    },
    "missingGlyph": {
      "type": "string",
      "minLength": 1
    },
    "glyphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/glyph"
      }
    },
    "kerning": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/kerning"
      }
    },
    "metadata": {
      "type": "object"
    },
    "layout": {
      "$ref": "#/$defs/layout"
    }
  },
  "required": [
    "format",
    "version",
    "id",
    "familyName",
    "styleName",
    "unitsPerEm",
    "metrics",
    "missingGlyph",
    "glyphs"
  ],
  "$defs": {
    "command": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "M"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "L"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "Q"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "C"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 7,
          "maxItems": 7
        }
      ]
    },
    "drawingCommand": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "L"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "Q"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "C"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 7,
          "maxItems": 7
        }
      ]
    },
    "contour": {
      "type": "object",
      "properties": {
        "closed": {
          "const": true
        },
        "commands": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100000,
          "prefixItems": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "const": "M"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          ],
          "items": {
            "$ref": "#/$defs/drawingCommand"
          }
        }
      },
      "required": [
        "closed",
        "commands"
      ],
      "not": {
        "required": [
          "penProfile"
        ]
      }
    },
    "stroke": {
      "type": "object",
      "properties": {
        "closed": {
          "type": "boolean"
        },
        "commands": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100000,
          "prefixItems": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "const": "M"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          ],
          "items": {
            "$ref": "#/$defs/drawingCommand"
          }
        },
        "kind": {
          "const": "stroke"
        },
        "penProfile": {
          "$ref": "#/$defs/penProfile"
        }
      },
      "required": [
        "closed",
        "commands"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "contours"
            ]
          },
          {
            "required": [
              "fillRule"
            ]
          }
        ]
      }
    },
    "fill": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "fill"
        },
        "fillRule": {
          "enum": [
            "evenodd",
            "nonzero"
          ]
        },
        "contours": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/contour"
          }
        }
      },
      "required": [
        "kind",
        "fillRule",
        "contours"
      ],
      "not": {
        "required": [
          "penProfile"
        ]
      }
    },
    "operation": {
      "oneOf": [
        {
          "$ref": "#/$defs/stroke"
        },
        {
          "$ref": "#/$defs/fill"
        }
      ]
    },
    "entry": {
      "type": "object",
      "properties": {
        "strokeIndex": {
          "const": 0
        },
        "endpoint": {
          "const": "start"
        },
        "userData": {
          "type": "object"
        }
      },
      "required": [
        "strokeIndex",
        "endpoint"
      ]
    },
    "exit": {
      "type": "object",
      "properties": {
        "strokeIndex": {
          "type": "integer",
          "minimum": 0
        },
        "endpoint": {
          "const": "end"
        },
        "userData": {
          "type": "object"
        }
      },
      "required": [
        "strokeIndex",
        "endpoint"
      ]
    },
    "anchor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "userData": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "x",
        "y"
      ]
    },
    "glyph": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unicodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9A-F]{4,6}$"
          },
          "uniqueItems": true
        },
        "advanceWidth": {
          "type": "number",
          "minimum": 0
        },
        "strokes": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "connections": {
          "type": "object",
          "properties": {
            "entry": {
              "$ref": "#/$defs/entry"
            },
            "exit": {
              "$ref": "#/$defs/exit"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anchor"
          }
        },
        "userData": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "unicodes",
        "advanceWidth",
        "strokes"
      ]
    },
    "kerning": {
      "type": "object",
      "properties": {
        "left": {
          "type": "string",
          "minLength": 1
        },
        "right": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "left",
        "right",
        "value"
      ]
    },
    "feature": {
      "type": "object",
      "properties": {
        "tag": {
          "type": "string",
          "pattern": "^[ -~]{4}$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        },
        "recommendedValue": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        }
      },
      "required": [
        "tag"
      ]
    },
    "system": {
      "type": "object",
      "properties": {
        "table": {
          "enum": [
            "GSUB",
            "GPOS"
          ]
        },
        "script": {
          "type": "string",
          "pattern": "^[ -~]{4}$"
        },
        "language": {
          "type": "string",
          "pattern": "^[ -~]{4}$"
        },
        "features": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[ -~]{4}$"
          },
          "uniqueItems": true
        },
        "requiredFeature": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[ -~]{4}$"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "table",
        "script",
        "language",
        "features",
        "requiredFeature"
      ]
    },
    "sourceBlock": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "code": {
          "type": "string"
        },
        "notes": {
          "type": "string"
        },
        "automatic": {
          "type": "boolean"
        },
        "disabled": {
          "type": "boolean"
        }
      },
      "required": [
        "name",
        "code",
        "notes",
        "automatic",
        "disabled"
      ]
    },
    "layoutSource": {
      "type": "object",
      "properties": {
        "format": {
          "enum": [
            "fea",
            "glyphs-feature-source-v1"
          ]
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "compiledSha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "content": {
          "type": [
            "string",
            "object"
          ]
        }
      },
      "required": [
        "format",
        "sha256",
        "compiledSha256",
        "content"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "format": {
                "const": "fea"
              }
            }
          },
          "then": {
            "properties": {
              "content": {
                "type": "string"
              }
            }
          },
          "else": {
            "properties": {
              "content": {
                "type": "object",
                "properties": {
                  "prefixes": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/sourceBlock"
                    }
                  },
                  "classes": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/sourceBlock"
                    }
                  },
                  "features": {
                    "type": "array",
                    "items": {
                      "$ref": "#/$defs/sourceBlock"
                    }
                  }
                },
                "required": [
                  "prefixes",
                  "classes",
                  "features"
                ]
              }
            }
          }
        }
      ]
    },
    "layout": {
      "type": "object",
      "properties": {
        "profile": {
          "const": "opentype-static-v1"
        },
        "font": {
          "type": "object",
          "properties": {
            "encoding": {
              "const": "base64"
            },
            "sha256": {
              "type": "string",
              "pattern": "^[a-f0-9]{64}$"
            },
            "data": {
              "type": "string",
              "minLength": 16,
              "maxLength": 11184812
            }
          },
          "required": [
            "encoding",
            "sha256",
            "data"
          ]
        },
        "glyphOrder": {
          "type": "array",
          "minItems": 1,
          "maxItems": 65535,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "uniqueItems": true
        },
        "features": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/feature"
          }
        },
        "systems": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/system"
          }
        },
        "source": {
          "$ref": "#/$defs/layoutSource"
        }
      },
      "required": [
        "profile",
        "font",
        "glyphOrder",
        "features",
        "systems"
      ]
    },
    "penChannels": {
      "type": "object",
      "properties": {
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "angle": {
          "type": "number"
        },
        "strokePosition": {
          "type": "number",
          "minimum": -1,
          "maximum": 1
        },
        "progressionIn": {
          "type": "number"
        },
        "progressionOut": {
          "type": "number"
        }
      },
      "required": [
        "width",
        "height",
        "angle",
        "strokePosition",
        "progressionIn",
        "progressionOut"
      ],
      "additionalProperties": false
    },
    "penPoint": {
      "type": "object",
      "properties": {
        "segment": {
          "type": "integer",
          "minimum": 0
        },
        "t": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "values": {
          "type": "object",
          "properties": {
            "width": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "height": {
              "anyOf": [
                {
                  "type": "number",
                  "exclusiveMinimum": 0
                },
                {
                  "type": "null"
                }
              ]
            },
            "angle": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "strokePosition": {
              "anyOf": [
                {
                  "type": "number",
                  "minimum": -1,
                  "maximum": 1
                },
                {
                  "type": "null"
                }
              ]
            },
            "progressionIn": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "progressionOut": {
              "anyOf": [
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false
        }
      },
      "required": [
        "segment",
        "t",
        "values"
      ],
      "additionalProperties": false
    },
    "penAppearance": {
      "type": "object",
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "bindingSha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "fillRule": {
          "const": "nonzero"
        },
        "contours": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {
            "$ref": "#/$defs/contour"
          }
        }
      },
      "required": [
        "source",
        "bindingSha256",
        "fillRule",
        "contours"
      ],
      "additionalProperties": false
    },
    "penProfile": {
      "type": "object",
      "properties": {
        "version": {
          "const": "1"
        },
        "model": {
          "enum": [
            "linear-ellipse-v1",
            "glyphs4-v1"
          ]
        },
        "defaults": {
          "$ref": "#/$defs/penChannels"
        },
        "points": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/penPoint"
          }
        },
        "style": {
          "type": "object",
          "properties": {
            "capStart": {
              "enum": [
                "butt",
                "round",
                "square"
              ]
            },
            "capEnd": {
              "enum": [
                "butt",
                "round",
                "square"
              ]
            },
            "join": {
              "enum": [
                "round",
                "bevel",
                "miter"
              ]
            }
          },
          "required": [
            "capStart",
            "capEnd",
            "join"
          ],
          "additionalProperties": false
        },
        "appearance": {
          "$ref": "#/$defs/penAppearance"
        }
      },
      "required": [
        "version",
        "model",
        "defaults",
        "points",
        "style"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "model": {
                "const": "glyphs4-v1"
              }
            }
          },
          "then": {
            "required": [
              "appearance"
            ]
          }
        }
      ]
    }
  }
}
