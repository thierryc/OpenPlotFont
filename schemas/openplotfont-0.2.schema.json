{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OpenPlotFont draft 0.2",
  "description": "Structural constraints; use the semantic validator for Unicode, references, uniqueness, finite numbers, and resource limits.",
  "type": "object",
  "properties": {
    "format": {
      "const": "OpenPlotFont"
    },
    "version": {
      "const": "0.2"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "familyName": {
      "type": "string",
      "minLength": 1
    },
    "styleName": {
      "type": "string",
      "minLength": 1
    },
    "unitsPerEm": {
      "type": "integer",
      "minimum": 1
    },
    "metrics": {
      "type": "object",
      "properties": {
        "ascender": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "descender": {
          "type": "number",
          "maximum": 0
        },
        "capHeight": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "xHeight": {
          "type": "number",
          "minimum": 0
        },
        "lineGap": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "ascender",
        "descender",
        "capHeight",
        "xHeight",
        "lineGap"
      ]
    },
    "missingGlyph": {
      "type": "string",
      "minLength": 1
    },
    "glyphs": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100000,
      "items": {
        "$ref": "#/$defs/glyph"
      }
    },
    "kerning": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/kerning"
      }
    },
    "metadata": {
      "type": "object"
    },
    "layout": false
  },
  "required": [
    "format",
    "version",
    "id",
    "familyName",
    "styleName",
    "unitsPerEm",
    "metrics",
    "missingGlyph",
    "glyphs"
  ],
  "$defs": {
    "command": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "M"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "L"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "Q"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "C"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 7,
          "maxItems": 7
        }
      ]
    },
    "drawingCommand": {
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "L"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 3,
          "maxItems": 3
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "Q"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 5,
          "maxItems": 5
        },
        {
          "type": "array",
          "prefixItems": [
            {
              "const": "C"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            },
            {
              "type": "number"
            }
          ],
          "items": false,
          "minItems": 7,
          "maxItems": 7
        }
      ]
    },
    "contour": {
      "type": "object",
      "properties": {
        "closed": {
          "const": true
        },
        "commands": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100000,
          "prefixItems": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "const": "M"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          ],
          "items": {
            "$ref": "#/$defs/drawingCommand"
          }
        }
      },
      "required": [
        "closed",
        "commands"
      ]
    },
    "stroke": {
      "type": "object",
      "properties": {
        "closed": {
          "type": "boolean"
        },
        "commands": {
          "type": "array",
          "minItems": 2,
          "maxItems": 100000,
          "prefixItems": [
            {
              "type": "array",
              "prefixItems": [
                {
                  "const": "M"
                },
                {
                  "type": "number"
                },
                {
                  "type": "number"
                }
              ],
              "items": false,
              "minItems": 3,
              "maxItems": 3
            }
          ],
          "items": {
            "$ref": "#/$defs/drawingCommand"
          }
        },
        "kind": {
          "const": "stroke"
        }
      },
      "required": [
        "closed",
        "commands"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "contours"
            ]
          },
          {
            "required": [
              "fillRule"
            ]
          }
        ]
      }
    },
    "fill": {
      "type": "object",
      "properties": {
        "kind": {
          "const": "fill"
        },
        "fillRule": {
          "enum": [
            "evenodd",
            "nonzero"
          ]
        },
        "contours": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/contour"
          }
        }
      },
      "required": [
        "kind",
        "fillRule",
        "contours"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "commands"
            ]
          },
          {
            "required": [
              "closed"
            ]
          }
        ]
      }
    },
    "operation": {
      "oneOf": [
        {
          "$ref": "#/$defs/stroke"
        },
        {
          "$ref": "#/$defs/fill"
        }
      ]
    },
    "entry": {
      "type": "object",
      "properties": {
        "strokeIndex": {
          "const": 0
        },
        "endpoint": {
          "const": "start"
        },
        "userData": {
          "type": "object"
        }
      },
      "required": [
        "strokeIndex",
        "endpoint"
      ]
    },
    "exit": {
      "type": "object",
      "properties": {
        "strokeIndex": {
          "type": "integer",
          "minimum": 0
        },
        "endpoint": {
          "const": "end"
        },
        "userData": {
          "type": "object"
        }
      },
      "required": [
        "strokeIndex",
        "endpoint"
      ]
    },
    "anchor": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "x": {
          "type": "number"
        },
        "y": {
          "type": "number"
        },
        "userData": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "x",
        "y"
      ]
    },
    "glyph": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "unicodes": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[0-9A-F]{4,6}$"
          },
          "uniqueItems": true
        },
        "advanceWidth": {
          "type": "number",
          "minimum": 0
        },
        "strokes": {
          "type": "array",
          "maxItems": 100000,
          "items": {
            "$ref": "#/$defs/operation"
          }
        },
        "connections": {
          "type": "object",
          "properties": {
            "entry": {
              "$ref": "#/$defs/entry"
            },
            "exit": {
              "$ref": "#/$defs/exit"
            }
          },
          "required": [],
          "additionalProperties": false
        },
        "anchors": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/anchor"
          }
        },
        "userData": {
          "type": "object"
        }
      },
      "required": [
        "name",
        "unicodes",
        "advanceWidth",
        "strokes"
      ]
    },
    "kerning": {
      "type": "object",
      "properties": {
        "left": {
          "type": "string",
          "minLength": 1
        },
        "right": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        }
      },
      "required": [
        "left",
        "right",
        "value"
      ]
    }
  }
}
